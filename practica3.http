@host = http://localhost:8080

### 1. GET categorías
GET {{host}}/api/categorias

### 2. POST categoría
POST {{host}}/api/categorias
Content-Type: application/json

{ "nombre": "Ciencia ficción" }

### 3. GET autores
GET {{host}}/api/autores

### 4. POST autor
POST {{host}}/api/autores
Content-Type: application/json

{ "nombre": "Isaac Asimov", "nacionalidad": "Estadounidense" }

### 5. GET libros
GET {{host}}/api/libros

### 6. GET libro por id
GET {{host}}/api/libros/1

### 7. POST libro
POST {{host}}/api/libros
Content-Type: application/json

{
  "titulo": "Fundación",
  "isbn": "9780553293357",
  "anioPublicacion": 1951,
  "autorId": 1,
  "categoriaId": 1
}

### 8. PUT libro
PUT {{host}}/api/libros/1
Content-Type: application/json

{
  "titulo": "Fundación (edición revisada)",
  "isbn": "9780553293357",
  "anioPublicacion": 1951,
  "autorId": 1,
  "categoriaId": 1
}

### 9. DELETE libro
DELETE {{host}}/api/libros/1

### 10. POST backup de la BD
POST {{host}}/api/database/backup

### 11. DELETE vaciar la BD
DELETE {{host}}/api/database/vaciar

### 12. GET health
GET {{host}}/api/health

### 13. POST login (devuelve el token)
# @name login
POST {{host}}/api/auth/login
Content-Type: application/json

{ "email": "admin@biblioteca.com", "password": "Admin123!" }

### 14. GET usuario de la sesión
GET {{host}}/api/auth/me
Authorization: Bearer {{login.response.body.data[0].token}}

### 15. GET usuarios
GET {{host}}/api/usuarios
Authorization: Bearer {{login.response.body.data[0].token}}

### 16. GET usuario por id
GET {{host}}/api/usuarios/1
Authorization: Bearer {{login.response.body.data[0].token}}

### 17. POST usuario
POST {{host}}/api/usuarios
Authorization: Bearer {{login.response.body.data[0].token}}
Content-Type: application/json

{ "nombre": "Ana Pérez", "email": "ana@biblioteca.com", "password": "secreta1", "rol": "editor" }

### 18. PUT usuario
PUT {{host}}/api/usuarios/2
Authorization: Bearer {{login.response.body.data[0].token}}
Content-Type: application/json

{ "nombre": "Ana Pérez López", "email": "ana@biblioteca.com", "rol": "admin" }

### 19. DELETE usuario
DELETE {{host}}/api/usuarios/2
Authorization: Bearer {{login.response.body.data[0].token}}
